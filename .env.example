# ---------------------------------------------------------------------------
# VoiceNote AI - configuration template
# Copy this file to `.env` and fill in your own keys.  NEVER commit `.env`.
# Streamlit Community Cloud users: put the same KEY=value pairs in the
# app's Secrets editor instead of shipping a file.
# ---------------------------------------------------------------------------

# --- Speech-to-text + speaker diarization + notes (Google Gemini) -----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Any chat-capable Gemini model your key can access. The sidebar lists the
# models your key actually exposes, so you can change it there too.
GEMINI_MODEL=gemini-2.5-flash

# --- Optional: Groq Whisper speech-to-text ----------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# whisper-large-v3-turbo (faster) or whisper-large-v3 (slightly more accurate)
GROQ_MODEL=whisper-large-v3-turbo

# --- Behaviour -------------------------------------------------------------
# gemini = transcript + speakers in one call | groq = Whisper text, speakers
# from a second Gemini pass over the same audio.
TRANSCRIPTION_ENGINE=gemini
# auto = identify speakers with Gemini | off = no speaker labels
DIARIZATION=auto
# auto, or an ISO-639-1 code such as en, ur, ar, hi, es, fr, de
LANGUAGE=auto

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_AUDIO_SECONDS=3600
STT_TIMEOUT=120
LLM_TIMEOUT=180
